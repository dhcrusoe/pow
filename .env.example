# Copy to .env and fill in. .env is gitignored; never commit it.
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# Local development needs NONE of this. `make api` writes commits to tmp/pow-log
# on disk, with no GitHub account and no network. Use that unless you have a
# specific reason not to.
# ---------------------------------------------------------------------------

# Point the local API at the real log instead. Read the warning in `make api-github`
# before you do: records written this way land in a public, append-only log and
# cannot be removed.
LOG_BACKEND=github
LOG_REPO=dhcrusoe/pow-log
LOG_BRANCH=main

# Fine-grained personal access token, scoped to pow-log only, Contents: read/write.
# github.com/settings/personal-access-tokens/new
#
# THIS FILE IS COMMITTED. Put the real value in .env, which is gitignored.
# Never paste a token here: this repository is public and history is forever.
GITHUB_TOKEN=PASTE_YOUR_TOKEN_IN_.env_NOT_HERE
