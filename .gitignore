# Secrets. Never commit a token; the log is public and history is forever.
.env
.env.*
!.env.example
*.pem

tmp/
site/
__pycache__/
*.egg-info/
.pytest_cache/
.venv/

# API credentials. secrets/.gitignore also ignores everything inside it.
secrets/*
!secrets/.gitignore

# Working documents. Plans and reviews, deliberately not part of the record.
Specs/
